      m_Items: []
  - m_Id: 15599575662593
    m_Localized: The official rules of the game.
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662594
    m_Localized: Up to 10 players. Each round, the last player gets one more face-down and one more face-up card; the first player loses one of each.
    m_Metadata:
      m_Items: []
