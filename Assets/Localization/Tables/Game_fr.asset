    m_Localized: "{0} retourne {1} et ramasse la d\xE9fausse"
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288153
    m_Localized: "La d\xE9fausse est br\xFBl\xE9e !"
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288154
    m_Localized: 'Pouvoir : {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288155
    m_Localized: "{0} doit ramasser la d\xE9fausse"
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288156
    m_Localized: '{0} n''a plus de cartes !'
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288157
    m_Localized: "Manche arr\xEAt\xE9e : plus aucun progr\xE8s possible."
    m_Metadata:
      m_Items: []
