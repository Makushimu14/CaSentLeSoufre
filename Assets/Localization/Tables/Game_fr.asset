  m_TableData:
  - m_Id: 1051361280
    m_Localized: "Les r\xE8gles sont manquantes."
    m_Metadata:
      m_Items: []
  - m_Id: 1135247360
    m_Localized: La liste des pouvoirs est manquante.
    m_Metadata:
      m_Items: []
  - m_Id: 1139441664
    m_Localized: "Au plus {0} pouvoirs peuvent \xEAtre actifs (vous en avez {1})."
    m_Metadata:
      m_Items: []
  - m_Id: 1139441665
    m_Localized: La valeur {0} n'est pas une valeur de carte valide.
    m_Metadata:
      m_Items: []
  - m_Id: 1143635968
    m_Localized: "La valeur {0} porte d\xE9j\xE0 un pouvoir."
    m_Metadata:
      m_Items: []
  - m_Id: 1143635969
    m_Localized: "Le pouvoir \xAB {0} \xBB est choisi plusieurs fois."
    m_Metadata:
      m_Items: []
  - m_Id: 1143635970
    m_Localized: Il faut entre {0} et {1} joueurs dans ce mode (vous en avez {2}).
    m_Metadata:
      m_Items: []
  - m_Id: 1143635971
    m_Localized: "Le nombre de manches doit \xEAtre compris entre {0} et {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 1143635972
    m_Localized: Chaque joueur doit avoir un nom.
    m_Metadata:
      m_Items: []
  - m_Id: 1143635973
    m_Localized: "Le nom \xAB {0} \xBB d\xE9passe {1} caract\xE8res."
    m_Metadata:
      m_Items: []
  - m_Id: 1143635974
    m_Localized: "Le nom \xAB {0} \xBB est utilis\xE9 plusieurs fois."
    m_Metadata:
      m_Items: []
  - m_Id: 1143635975
    m_Localized: "Remise \xE0 z\xE9ro"
    m_Metadata:
      m_Items: []
  - m_Id: 1143635976
    m_Localized: Jouable sur tout. Le suivant peut jouer n'importe quelle carte.
    m_Metadata:
      m_Items: []
  - m_Id: 1143635977
    m_Localized: "Br\xFBlure"
    m_Metadata:
      m_Items: []
  - m_Id: 1143635978
    m_Localized: "Br\xFBle la d\xE9fausse et vous rejouez. Se pose comme une carte ordinaire, selon sa valeur."
    m_Metadata:
      m_Items: []
  - m_Id: 1143635979
    m_Localized: Transparent
    m_Metadata:
      m_Items: []
  - m_Id: 1143635980
    m_Localized: "Se pose selon sa valeur. Le suivant doit battre la carte situ\xE9e dessous."
    m_Metadata:
      m_Items: []
  - m_Id: 1143635981
    m_Localized: Plus bas
    m_Metadata:
      m_Items: []
  - m_Id: 1143635982
    m_Localized: "Le suivant doit jouer une carte de valeur inf\xE9rieure ou \xE9gale."
    m_Metadata:
      m_Items: []
  - m_Id: 1143635983
    m_Localized: Saute un tour
    m_Metadata:
      m_Items: []
  - m_Id: 1143635984
    m_Localized: "Le suivant passe son tour (un joueur de plus par carte jou\xE9e)."
    m_Metadata:
      m_Items: []
  - m_Id: 1143635985
    m_Localized: Inverse le sens
    m_Metadata:
      m_Items: []
  - m_Id: 1143635986
    m_Localized: Le sens du jeu s'inverse.
    m_Metadata:
      m_Items: []
  - m_Id: 1143635987
    m_Localized: "Ramassage forc\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 1143635988
    m_Localized: "Le suivant ramasse la d\xE9fausse et passe son tour."
    m_Metadata:
      m_Items: []
  - m_Id: 1143635989
    m_Localized: Rejouer
    m_Metadata:
      m_Items: []
  - m_Id: 1143635990
    m_Localized: "Vous rejouez imm\xE9diatement."
    m_Metadata:
      m_Items: []
  - m_Id: 1143635991
    m_Localized: V
    m_Metadata:
      m_Items: []
  - m_Id: 1143635992
    m_Localized: D
    m_Metadata:
      m_Items: []
  - m_Id: 1143635993
    m_Localized: R
    m_Metadata:
      m_Items: []
  - m_Id: 1143635994
    m_Localized: A
    m_Metadata:
      m_Items: []
  - m_Id: 1143635995
    m_Localized: "R\xE8gles officielles"
    m_Metadata:
      m_Items: []
  - m_Id: 1143635996
    m_Localized: "Mode d\xE9mon"
    m_Metadata:
      m_Items: []
  - m_Id: 1143635997
    m_Localized: Facile
    m_Metadata:
      m_Items: []
  - m_Id: 1143635998
    m_Localized: Normale
    m_Metadata:
      m_Items: []
  - m_Id: 1143635999
    m_Localized: Difficile
    m_Metadata:
      m_Items: []
  - m_Id: 728192679936
    m_Localized: "\xC7a Sent le Soufre"
    m_Metadata:
      m_Items: []
  - m_Id: 15599516942336
    m_Localized: "R\xE8gles"
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662592
    m_Localized: Mode de jeu
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662593
    m_Localized: "Les r\xE8gles officielles du Trois-Trois."
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662594
    m_Localized: "Jusqu'\xE0 10 joueurs. \xC0 chaque manche, le dernier re\xE7oit une carte cach\xE9e et une visible de plus ; le premier en perd une de chaque."
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662595
    m_Localized: Joueurs ({0}/{1})
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662596
    m_Localized: Vous
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662597
    m_Localized: Nom
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662598
    m_Localized: + Ajouter un adversaire
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662599
    m_Localized: Retirer
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662600
    m_Localized: Manches
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662601
    m_Localized: Nombre de manches
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662602
    m_Localized: Pouvoirs de cartes ({0}/{1})
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662603
    m_Localized: Activez les pouvoirs que vous voulez et choisissez la valeur de carte qui porte chacun.
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662604
    m_Localized: Valeur
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662605
    m_Localized: Options
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662606
    m_Localized: "Le jeu complet br\xFBle la d\xE9fausse"
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662607
    m_Localized: "Toutes les cartes d'une m\xEAme valeur pos\xE9es \xE0 la suite (4 par paquet utilis\xE9) br\xFBlent la d\xE9fausse et le joueur rejoue."
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662608
    m_Localized: "Jeu \xE0 la vol\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662609
    m_Localized: "Hors de votre tour, posez la derni\xE8re carte d'un jeu complet de m\xEAme valeur (3 d\xE9j\xE0 pos\xE9es avec un paquet, 7 avec deux...)."
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662610
    m_Localized: "\xC9change de d\xE9but de manche"
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662611
    m_Localized: "\xC9changez des cartes de votre main avec vos cartes visibles avant de jouer."
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662612
    m_Localized: Lancer la partie
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662613
    m_Localized: "R\xE9glages \xE0 corriger"
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662614
    m_Localized: La table de jeu n'est pas encore disponible.
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662615
    m_Localized: Langue
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662616
    m_Localized: "Fran\xE7ais"
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662617
    m_Localized: English
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662618
    m_Localized: Valet
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662619
    m_Localized: Dame
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662620
    m_Localized: Roi
    m_Metadata:
      m_Items: []
  - m_Id: 15599575662621
    m_Localized: As
    m_Metadata:
      m_Items: []
  - m_Id: 19488312033280
    m_Localized: "M\xEAme valeur ou t\xEAte"
    m_Metadata:
      m_Items: []
  - m_Id: 19488370753536
    m_Localized: "Le suivant doit jouer la m\xEAme valeur ou une t\xEAte (valet, dame, roi)."
    m_Metadata:
      m_Items: []
  - m_Id: 19488370753537
    m_Localized: "Param\xE8tres"
    m_Metadata:
      m_Items: []
  - m_Id: 19488370753538
    m_Localized: Retour
    m_Metadata:
      m_Items: []
  - m_Id: 19488370753539
    m_Localized: Partie rapide
    m_Metadata:
      m_Items: []
  - m_Id: 19488370753540
    m_Localized: Nombre de joueurs
    m_Metadata:
      m_Items: []
  - m_Id: 19488370753541
    m_Localized: 'Adversaires : {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 19488370753542
    m_Localized: "Corrigez vos param\xE8tres pour pouvoir jouer."
    m_Metadata:
      m_Items: []
  - m_Id: 19488370753543
    m_Localized: Votre profil
    m_Metadata:
      m_Items: []
  - m_Id: 19488370753544
    m_Localized: Votre nom
    m_Metadata:
      m_Items: []
  - m_Id: 19488370753545
    m_Localized: Adversaires (IA)
    m_Metadata:
      m_Items: []
  - m_Id: 19488370753546
    m_Localized: "Ces adversaires sont m\xE9moris\xE9s. Selon le nombre de joueurs choisi, seuls les premiers jouent."
    m_Metadata:
      m_Items: []
  - m_Id: 19488370753547
    m_Localized: "inutilis\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 19488370753548
    m_Localized: "Vos param\xE8tres sont enregistr\xE9s automatiquement."
    m_Metadata:
      m_Items: []
  - m_Id: 24779111956480
    m_Localized: Manche {0}/{1}
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288128
    m_Localized: Tour de {0}
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288129
    m_Localized: "\xC0 vous de jouer"
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288130
    m_Localized: "Sens invers\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288131
