    m_Localized: Votre main
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288135
    m_Localized: Cartes visibles
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288136
    m_Localized: "Cartes cach\xE9es"
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288137
    m_Localized: "Main : {0}  -  Cach\xE9es : {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288138
    m_Localized: Sorti
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288139
    m_Localized: "\xC9changez : cliquez une carte de votre main puis une carte visible, puis validez."
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288140
    m_Localized: "Aucune carte jouable : ramassez la d\xE9fausse."
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288141
    m_Localized: "Jouez une carte cach\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288142
    m_Localized: "Vous pouvez jouer \xE0 la vol\xE9e !"
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288143
    m_Localized: "Cliquez de nouveau sur la s\xE9lection pour la jouer."
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288144
    m_Localized: "Pr\xEAt"
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288145
    m_Localized: Jouer
    m_Metadata:
      m_Items: []
  - m_Id: 24779162288146
    m_Localized: "Ramasser la d\xE9fausse"
    m_Metadata:
      m_Items: []
