<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Génère les images des cartes (Assets/Resources/Cards/*.png).
    Lancement : dotnet run (option) project Tools/CardArt, depuis le dossier du projet Unity.
    Hors du dossier Assets : Unity ne le voit pas. Windows uniquement (System.Drawing).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

</Project>
