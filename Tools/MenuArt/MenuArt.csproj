<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Génère le fond d'écran du menu (Assets/Resources/UI/menu_background.jpg).
    Lancement : dotnet run (option project) Tools/MenuArt, depuis le dossier du projet Unity.
    Hors du dossier Assets : Unity ne le voit pas. Windows uniquement (System.Drawing).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

</Project>
